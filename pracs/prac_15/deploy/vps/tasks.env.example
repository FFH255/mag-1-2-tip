# tasks.env — переменные окружения сервиса tasks (ПЗ №15).
# На VPS этот файл живёт по пути /etc/tasks/tasks.env с правами root:root 0600
# (секреты отдельно от кода и не попадают в репозиторий).
#
# Значения переменных взяты из реального main.go сервиса
# (services/tasks/cmd/tasks/main.go) и docker-compose, а НЕ из примера методички:
# методичка показывает AUTH_BASE_URL=http://... и LOG_LEVEL, но сервис tasks
# ходит в auth по gRPC (AUTH_GRPC_ADDR), а уровень логирования сейчас задан в
# коде (logrus DebugLevel) и переменной не управляется.

# HTTP-порт сервиса. Методичка предлагает 8082; дефолт в коде — 8086.
TASKS_PORT=8082

# Адрес auth по gRPC (НЕ http). Дефолт в коде: localhost:50051.
AUTH_GRPC_ADDR=127.0.0.1:50051

# Подключение к PostgreSQL. ЕДИНСТВЕННАЯ жёсткая зависимость: при недоступной
# БД сервис не стартует (Fatal на pool.Ping). Пароль здесь — это секрет,
# поэтому файл и закрыт правами 0600.
TASKS_DB_DSN=postgres://tasks:tasks@127.0.0.1:5432/tasks?sslmode=disable

# Кэш Redis (ПЗ №9). Необязателен: пустой REDIS_ADDR → DB-only режим.
REDIS_ADDR=127.0.0.1:6379
CACHE_TTL_SECONDS=120
CACHE_TTL_JITTER_SECONDS=30
# REDIS_PASSWORD=
# REDIS_DB=0

# Брокер событий/задач RabbitMQ (ПЗ №13–14). Необязателен (best-effort):
# пустой RABBIT_URL → публикация и постановка job'ов отключены.
RABBIT_URL=amqp://guest:guest@127.0.0.1:5672/
QUEUE_NAME=task_events

# Идентификатор реплики (ПЗ №10). Если пусто — подставится hostname.
# INSTANCE_ID=tasks-vps-1
